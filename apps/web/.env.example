# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Estes dois valores são PÚBLICOS por natureza:
# o acesso aos dados é protegido pelas políticas RLS no banco.
# NUNCA coloque aqui a chave service_role / secret.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
